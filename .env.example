# Copy to .env and fill only the services you choose to use. Never commit .env.

# Alpha Vantage: manual spot quotes for portfolio holdings and SPY.
ALPHA_VANTAGE_API_KEY=

# Tiingo: manual refreshes of adjusted daily OHLCV history.
TIINGO_API_KEY=

# FRED: manual refresh of VIXCLS and selected Treasury, policy-rate, and credit series.
# FRED_API_KEY is used only after you click the corresponding refresh control.
FRED_API_KEY=

# AI Market Analyst and Research workspace provider selection.
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# Optional bounded timeouts for explicit Market Intelligence requests (seconds).
DEEPSEEK_CONNECT_TIMEOUT_SECONDS=10
DEEPSEEK_READ_TIMEOUT_SECONDS=180

# Optional alternative provider. Select OpenAI in the in-app AI settings.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Optional: replace the default cautious research-assistant system instructions.
# Leave blank to use the built-in rigorous strategist prompt.
RESEARCH_STRATEGIST_PROMPT=
